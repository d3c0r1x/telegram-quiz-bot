[TEMPLATE]
# Токен бота от @BotFather (обязательно)
QUIZ_BOT_TOKEN=123456:ABC-DEF...

# 1 = оффлайн-режим (встроенный пул вопросов) | 0 = OpenTDB API
QUIZ_DEMO_MODE=1

# Вопросов за одну игру
QUIZ_QUESTIONS_PER_GAME=10

# --- Продвинутые настройки ---
# Сложность по умолчанию: any | easy | medium | hard (можно выбрать в /quiz)
QUIZ_DIFFICULTY=any
# Брошенные игры вычищаются через N секунд
QUIZ_GAME_TTL_SECONDS=1800
# Минимальный интервал между сообщениями пользователя (секунды)
THROTTLE_MIN_INTERVAL=0.7
